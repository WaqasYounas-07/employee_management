# Copy to .env and adjust. Never commit the real .env.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Karachi

# Database: sqlite (default) or postgres
DB_ENGINE=sqlite
# DB_NAME=employee_management
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Face recognition
# auto = use face_recognition if installed, else the development stub
FACE_ENGINE=auto
FACE_DETECTION_MODEL=hog
FACE_MIN_ENROLL_QUALITY=0.08
FACE_TEMPLATE_CACHE_SECONDS=300
# Must stay False in production unless you knowingly accept the stub
FACE_ALLOW_STUB=False

# Attendance rules
ATTENDANCE_DUPLICATE_COOLDOWN_MINUTES=5
ATTENDANCE_MIN_CHECKOUT_MINUTES=60
ATTENDANCE_OVERNIGHT_GRACE_MINUTES=180
